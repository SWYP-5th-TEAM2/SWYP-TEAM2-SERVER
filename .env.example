APP_NAME=SWYP TEAM2 SERVER
APP_ENV=local
DEBUG=true

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/swyp_team2

JWT_SECRET_KEY=change-this-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14


REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=redis-password


KAKAO_CLIENT_ID=kakao-client-id
KAKAO_REDIRECT_URI=kakao-redirect-uri
KAKAO_CLIENT_SECRET=kakao-client-secret
KAKAO_LOCAL_REST_API_KEY=kakao-local-rest-api-key
NAVER_LOCAL_CLIENT_ID=naver-local-client-id
NAVER_LOCAL_CLIENT_SECRET=naver-local-client-secret

GOOGLE_CLIENT_ID=google-web-client-id

APPLE_TEAM_ID=apple-team-id
APPLE_CLIENT_ID=apple-client-id
APPLE_KEY_ID=apple-key-id
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

AZURE_STORAGE_CONNECTION_STRING=azure-storage-connection-string
AZURE_STORAGE_CONTAINER_NAME=images
MAX_IMAGE_SIZE_MB=5

# Firebase FCM
FIREBASE_PUSH_ENABLED=false
FIREBASE_PROJECT_ID=firebase-project-id
FIREBASE_CREDENTIALS_PATH=./firebase-service-account.json

# AI image extraction
# Supported values: GEMINI, OPENAI, ANTHROPIC
IMAGE_EXTRACTION_AI_PROVIDER=GEMINI

# Gemini image extraction
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_REQUEST_TIMEOUT_SECONDS=30

# OpenAI or OpenAI-compatible image extraction
# Official OpenAI: keep OPENAI_BASE_URL=https://api.openai.com/v1 and OPENAI_API_MODE=AUTO or RESPONSES.
# OpenAI-compatible providers: set provider base URL and OPENAI_API_MODE=CHAT_COMPLETIONS.
OPENAI_API_KEY=your-openai-or-compatible-provider-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_MODE=AUTO
OPENAI_IMAGE_EXTRACTION_MODEL=your-openai-or-compatible-vision-model
OPENAI_REQUEST_TIMEOUT_SECONDS=30

# Anthropic Claude image extraction
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_IMAGE_EXTRACTION_MODEL=your-claude-vision-model
ANTHROPIC_API_VERSION=2023-06-01
ANTHROPIC_MAX_TOKENS=2048
ANTHROPIC_REQUEST_TIMEOUT_SECONDS=30
